prefix=E:/KESSH/libssh2-out/x86_64
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libssh2
URL: https://libssh2.org/
Description: Library for SSH-based communication
Version: 1.11.1
Requires: wolfssl
Requires.private: wolfssl
Libs: -L${libdir} -lssh2 -LE:/KESSH/wolfssl-out/x86_64/lib -lwolfssl
Libs.private: -LE:/KESSH/wolfssl-out/x86_64/lib -lwolfssl
Cflags: -I${includedir}
