prefix=E:/KESSH/libssh2-out/armeabi-v7a
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libssh2
URL: https://libssh2.org/
Description: Library for SSH-based communication
Version: 1.11.1
Requires: mbedcrypto
Requires.private: mbedcrypto
Libs: -L${libdir} -lssh2 -LE:/KESSH/mbedtls-out/armeabi-v7a/lib -lmbedcrypto -lmbedtls -lmbedx509
Libs.private: -LE:/KESSH/mbedtls-out/armeabi-v7a/lib -lmbedcrypto -lmbedtls -lmbedx509
Cflags: -I${includedir}
